            <div class="passport-card">

                <div class="passport-card-header">

                    <div class="passport-logo">
                        V
                    </div>

                    <div>
                        <span>VERA</span>
                        <strong>Fulfilment Passport</strong>
                    </div>

                    <span class="passport-verified">
                        <i class="bi bi-patch-check-fill"></i>
                        VERIFIED HISTORY
                    </span>

                </div>


                <div class="passport-business">

                    <div class="passport-avatar">
                        NT
                    </div>

                    <div>
                        <h4>Nomvula Tech Solutions</h4>
                        <p>Business technology supplier</p>
                    </div>

                </div>


                <div class="passport-stats">

                    <div>
                        <strong>4</strong>

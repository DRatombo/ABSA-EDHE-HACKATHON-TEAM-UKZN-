@{
    ViewData["Title"] = "Turn opportunity into execution";
}

<!-- =====================================================
     HERO
===================================================== -->

@{
    ViewData["Title"] = "Turn opportunity into execution";
}

<section class="vera-hero">

    <div class="vera-hero-shape vera-hero-shape-one"></div>
    <div class="vera-hero-shape vera-hero-shape-two"></div>

    <div class="vera-container vera-hero-grid">

        <div class="vera-hero-content">

            

            <h1>
                Got the opportunity?
                <span>Let's fund the journey.'</span>
            </h1>

            <p class="vera-hero-description">
                VERA assists in helping SMEs access the working capital they need
                to fufill their supply chain. We verify, assess and structure the opportunity, so funders can make informed decisions.
            </p>

            <div class="vera-hero-actions">

                <a class="vera-primary-button vera-main-cta"
                   asp-controller="Account"
                   asp-action="Register">

                    I want the opportunity

                    <i class="bi bi-arrow-right"></i>
                </a>

                <a class="vera-video-button"
                   asp-controller="Home"
                   asp-action="HowItWorks">

                    <span class="vera-play-icon">
                        <i class="bi bi-play-fill"></i>
                    </span>

                    More About Vera
                </a>

            </div>

            <div class="vera-feature-row">

                <div class="vera-feature-item">

                    <div class="vera-feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <span>
                        Opportunity<br />
                        verification
                    </span>

                </div>

                <div class="vera-feature-item">

                    <div class="vera-feature-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <span>
                        Fulfilment<br />
                        assessment
                    </span>

                </div>

                <div class="vera-feature-item">

                    <div class="vera-feature-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <span>
                        Controlled<br />
                        funding
                    </span>

                </div>

            </div>

        </div>


        <div class="vera-hero-visual">

            <div class="vera-opportunity-card">

                <div class="vera-card-top">

                    <div>
                        <span class="vera-card-eyebrow">
                            OPPORTUNITY
                        </span>

                        <h3>PO #EC-45821</h3>
                    </div>

                    <span class="vera-status-review">
                        REVIEW
                    </span>

                </div>

                <div class="vera-card-business">

                    <div class="vera-business-avatar">
                        NT
                    </div>

                    <div>
                        <strong>
                            Nomvula Tech Solutions
                        </strong>

                        <span>
                            Business technology supplier
                        </span>
                    </div>

                </div>

                <div class="vera-metric-grid">

                    <div class="vera-metric-card">

                        <div class="vera-metric-icon">
                            <i class="bi bi-building"></i>
                        </div>

                        <div>
                            <span>Buyer</span>
                            <strong>Durban Metro Municipality</strong>
                        </div>

                    </div>

                    <div class="vera-metric-card">

                        <div class="vera-metric-icon vera-metric-red">
                            <i class="bi bi-cash-coin"></i>
                        </div>

                        <div>
                            <span>PO value</span>
                            <strong class="vera-red-text">
                                R300,000
                            </strong>
                        </div>

                    </div>

                </div>

                <div class="vera-verification-header">

                    <div>
                        <strong>
                            Verification profile
                        </strong>

                        <span>
                            5 of 6 checks complete
                        </span>
                    </div>

                    <strong class="vera-red-text">
                        83%
                    </strong>

                </div>

                <div class="vera-verification-bar">
                    <div></div>
                </div>

                <div class="vera-check-list">

                    <div>
                        <span>
                            <i class="bi bi-check-circle-fill"></i>
                            Business identity
                        </span>

                        <strong>VERIFIED</strong>
                    </div>

                    <div>
                        <span>
                            <i class="bi bi-check-circle-fill"></i>
                            PO document integrity
                        </span>

                        <strong>VERIFIED</strong>
                    </div>

                    <div>
                        <span>
                            <i class="bi bi-check-circle-fill"></i>
                            Buyer confirmation
                        </span>

                        <strong>VERIFIED</strong>
                    </div>

                    <div>
                        <span>
                            <i class="bi bi-check-circle-fill"></i>
                            Supplier evidence
                        </span>

                        <strong>VERIFIED</strong>
                    </div>

                    <div>
                        <span>
                            <i class="bi bi-check-circle-fill"></i>
                            Duplicate financing
                        </span>

                        <strong>CLEAR</strong>
                    </div>

                    <div class="vera-review-line">
                        <span>
                            <i class="bi bi-exclamation-circle-fill"></i>
                            Fulfilment capacity
                        </span>

                        <strong>REVIEW</strong>
                    </div>

                </div>

                <div class="vera-capacity-warning">

                    <div class="vera-warning-icon">
                        <i class="bi bi-exclamation-lg"></i>
                    </div>

                    <div>
                        <strong>
                            Capacity review required
                        </strong>

                        <span>
                            This PO is 4× larger than the SME’s
                            previous verified opportunity.
                        </span>
                    </div>

                </div>

            </div>


            <div class="vera-funding-float">

                <div class="vera-floating-arrow">
                    <i class="bi bi-arrow-up-right"></i>
                </div>

                <div>
                    <span>Funding gap</span>

                    <strong>R184,500</strong>

                    <small>
                        Turn opportunity into progress
                    </small>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- =====================================================
     THE GAP
===================================================== -->

<section class="home-gap">

    <div class="vera-container">

        <div class="home-gap-grid">

            <!-- LEFT -->
            <div class="home-gap-heading">

                <div class="home-section-kicker home-kicker-light">
                    <span>01</span>
                    THE GAP
                </div>

                <h2>
                    Winning the contract
                    <span>shouldn't be where growth stops.</span>
                </h2>

            </div>


            <!-- RIGHT -->
            <div class="home-gap-content">

                <p>
                    A purchase order/Invoice confirms the demand.
                    It doesn't mean an SME has the cash available today
                    to purchase stock, pay suppliers and execute the work.
                </p>

                <div class="home-gap-stat">

                    <div class="home-gap-stat-icon">
                        <i class="bi bi-arrow-down-right"></i>
                    </div>

                    <div>
                        <span>THE PROBLEM</span>

                        <strong>
                            The opportunity exists.
                            The working capital doesn't.
                        </strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- FLOW -->
        <div class="home-gap-flow">

            <div class="home-gap-flow-item">

                <div class="gap-flow-icon">
                    <i class="bi bi-file-earmark-check"></i>
                </div>

                <div>
                    <span>01</span>
                    <strong>PO won</strong>
                    <small>A real commercial opportunity</small>
                </div>

            </div>

            <i class="bi bi-arrow-right gap-arrow"></i>


            <div class="home-gap-flow-item">

                <div class="gap-flow-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <span>02</span>
                    <strong>Fulfilment needed</strong>
                    <small>Stock, suppliers and execution</small>
                </div>

            </div>

            <i class="bi bi-arrow-right gap-arrow"></i>


            <div class="home-gap-flow-item gap-problem">

                <div class="gap-flow-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>
                    <span>03</span>
                    <strong>Funding gap</strong>
                    <small>Working capital is missing</small>
                </div>

            </div>

            <i class="bi bi-arrow-right gap-arrow"></i>


            <div class="home-gap-flow-item gap-vera">

                <div class="gap-flow-icon">
                    V
                </div>

                <div>
                    <span>04</span>
                    <strong>VERA</strong>
                    <small>Turns evidence into opportunity intelligence</small>
                </div>

            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     VERA JOURNEY
===================================================== -->

<section class="home-journey">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>02</span>
                    FROM OPPORTUNITY TO OUTCOME
                </div>

                <h2>
                    One journey.
                    <span>Every step visible.</span>
                </h2>

            </div>

            <p>
                VERA structures the journey around the opportunity itself.
                From evidence and verification through funding,
                execution and settlement.
            </p>

        </div>


        <div class="home-journey-track">

            <!-- 01 -->
            <article class="home-journey-card journey-red">

                <div class="journey-card-top">
                    <span>01</span>

                    <div class="journey-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>

                <h3>Verify</h3>

                <p>
                    Check the SME, purchase order, buyer,
                    supplier evidence and document integrity.
                </p>

                <div class="journey-result">
                    <i class="bi bi-check2-circle"></i>
                    PASS • REVIEW • BLOCK
                </div>

            </article>


            <!-- 02 -->
            <article class="home-journey-card journey-navy">

                <div class="journey-card-top">
                    <span>02</span>

                    <div class="journey-icon">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                </div>

                <h3>Assess</h3>

                <p>
                    Understand whether the SME can realistically
                    execute this specific opportunity.
                </p>

                <div class="journey-result">
                    <i class="bi bi-graph-up"></i>
                    FULFILMENT READINESS
                </div>

            </article>


            <!-- 03 -->
            <article class="home-journey-card journey-gold">

                <div class="journey-card-top">
                    <span>03</span>

                    <div class="journey-icon">
                        <i class="bi bi-calculator"></i>
                    </div>
                </div>

                <h3>Structure</h3>

                <p>
                    Calculate fulfilment cost, any SME contribution
                    and the actual funding gap.
                </p>

                <div class="journey-result">
                    <i class="bi bi-cash-stack"></i>
                    FUNDING REQUIREMENT
                </div>

            </article>


            <!-- 04 -->
            <article class="home-journey-card journey-purple">

                <div class="journey-card-top">
                    <span>04</span>

                    <div class="journey-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                </div>

                <h3>Match</h3>

                <p>
                    Present a finance ready Opportunity Profile
                    for an informed funding decision.
                </p>

                <div class="journey-result">
                    <i class="bi bi-arrow-left-right"></i>
                    FUNDING OPTIONS
                </div>

            </article>


            <!-- 05 -->
            <article class="home-journey-card journey-green">

                <div class="journey-card-top">
                    <span>05</span>

                    <div class="journey-icon">
                        <i class="bi bi-truck"></i>
                    </div>
                </div>

                <h3>Execute</h3>

                <p>
                    Link approved finance to verified
                    fulfilment costs and suppliers.
                </p>

                <div class="journey-result">
                    <i class="bi bi-lock"></i>
                    CONTROLLED FUNDING
                </div>

            </article>


            <!-- 06 -->
            <article class="home-journey-card journey-dark">

                <div class="journey-card-top">
                    <span>06</span>

                    <div class="journey-icon">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>

                <h3>Settle</h3>

                <p>
                    Track execution, buyer payment and
                    settlement against the funded opportunity.
                </p>

                <div class="journey-result">
                    <i class="bi bi-check-circle"></i>
                    VERIFIED OUTCOME
                </div>

            </article>

        </div>

    </div>

</section>



<!-- =====================================================
     FULFILMENT PASSPORT
===================================================== -->

<section class="home-passport">

    <div class="vera-container home-passport-grid">


        <!-- LEFT: MOCK PASSPORT -->

        <div class="passport-visual">

            <div class="passport-decoration passport-decoration-one"></div>

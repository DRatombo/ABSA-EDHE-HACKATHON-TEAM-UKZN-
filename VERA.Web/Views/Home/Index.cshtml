</section>



<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="home-final">

    <div class="home-final-orb final-orb-one"></div>
    <div class="home-final-orb final-orb-two"></div>

    <div class="vera-container">

        <div class="home-final-inner">

            <div class="final-icon">
                <i class="bi bi-arrow-up-right"></i>
            </div>

            <div class="final-copy">

                <span class="final-eyebrow">
                    YOUR OPPORTUNITY STARTS HERE
                </span>

                <h2>
                    Turn the PO you've won
                    <span>into the growth you've earned.</span>
                </h2>

                <p>
                    Create your first VERA Opportunity Profile
                    and start the journey from verification to fulfilment.
                </p>

            </div>


            <div class="final-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="final-primary">

                    Start your opportunity

                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Home"
                   asp-action="HowItWorks"
                   class="final-secondary">

                    How VERA works

                </a>

            </div>

        </div>

    </div>

</section>


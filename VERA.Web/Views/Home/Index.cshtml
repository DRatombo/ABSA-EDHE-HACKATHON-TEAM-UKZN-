                    </div>

                    <div>
                        <strong>R685k</strong>
                        <span>Verified PO value</span>
                    </div>

                    <div>
                        <strong>100%</strong>
                        <span>Settled</span>
                    </div>

                </div>


                <div class="passport-history">

                    <div>
                        <span class="history-dot"></span>

                        <div>
                            <strong>PO #EC-31219</strong>

@{
    ViewData["Title"] = "VERA for SMEs";
}

<!-- =====================================================
     HERO
===================================================== -->

<section class="how-hero">

    <div class="how-hero-orb how-orb-one"></div>
    <div class="how-hero-orb how-orb-two"></div>

    <div class="vera-container how-hero-grid how-hero-solo">

        <div class="how-hero-copy">

            <div class="home-section-kicker">
                <span><i class="bi bi-briefcase"></i></span>
                FOR SMEs
            </div>

            <h1>
                You won the contract.
                <span>Let's help you deliver it.</span>
            </h1>

            <p>
                VERA turns the purchase order you've already won into
                a verified, finance-ready opportunity — so the real
                obstacle to growth isn't the working capital you don't have.
            </p>

            <div class="how-hero-actions">

                <a class="vera-primary-button vera-main-cta"
                   asp-controller="Account"
                   asp-action="Register">

                    Start your opportunity

                    <i class="bi bi-arrow-right"></i>
                </a>

                <a class="vera-video-button"
                   asp-controller="Home"
                   asp-action="HowItWorks">

                    <span class="vera-play-icon">
                        <i class="bi bi-play-fill"></i>
                    </span>

                    See how VERA works
                </a>

            </div>

            <div class="how-stat-row">

                <div class="how-stat-card">
                    <strong>6</strong>
                    <span>Stages from PO to settlement</span>
                </div>

                <div class="how-stat-card">
                    <strong>83%</strong>
                    <span>Average verification completeness</span>
                </div>

                <div class="how-stat-card">
                    <strong>1</strong>
                    <span>Growing Fulfilment Passport</span>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     WHY SMEs CHOOSE VERA
===================================================== -->

<section class="how-checks">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>01</span>
                    WHY SMEs CHOOSE VERA
                </div>

                <h2>
                    Built around the opportunity
                    <span>you've already earned.</span>
                </h2>

            </div>

            <p>
                VERA doesn't ask you to prove yourself from scratch every time.
                It builds a clear, evidence-backed picture of this opportunity —
                and keeps that evidence working for the next one.
            </p>

        </div>


        <div class="how-check-grid">

            <article class="how-check-card">
                <i class="bi bi-shield-check"></i>
                <h3>Verified, not guessed</h3>
                <p>
                    Your business, purchase order, buyer and supplier
                    evidence are checked properly, so funders see a
                    real opportunity, not a rough application.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-calculator"></i>
                <h3>Your real funding gap</h3>
                <p>
                    VERA calculates fulfilment cost, your own contribution
                    and the actual working-capital gap — not a generic
                    loan amount.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-arrow-left-right"></i>
                <h3>Faster funder decisions</h3>
                <p>
                    A finance-ready Opportunity Profile means funders can
                    review real evidence instead of waiting on back-and-forth
                    paperwork.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-lock"></i>
                <h3>Funding tied to fulfilment</h3>
                <p>
                    Where finance is approved, it can be linked to verified
                    suppliers and costs — protecting you from misused or
                    misdirected funds.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-bar-chart"></i>
                <h3>Proof that compounds</h3>
                <p>
                    Every opportunity you settle adds to your Fulfilment
                    Passport, making your next application faster and stronger.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-eye"></i>
                <h3>No hidden scoring</h3>
                <p>
                    You can see exactly which checks passed, which need
                    review, and why — never a single unexplained number.
                </p>
            </article>

        </div>

    </div>

</section>


<!-- =====================================================
     THE SME JOURNEY
===================================================== -->

<section class="how-process">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>02</span>
                    YOUR JOURNEY
                </div>

                <h2>
                    From uploaded PO
                    <span>to funded execution.</span>
                </h2>

            </div>

            <p>
                Four simple stages stand between the opportunity you've
                won and the working capital you need to deliver it.
            </p>

        </div>


        <div class="how-step-list">

            <article class="how-step how-step-red">

                <div class="how-step-number">01</div>

                <div class="how-step-icon">
                    <i class="bi bi-upload"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">SUBMIT</span>
                    <h3>Upload your purchase order</h3>
                    <p>
                        Add your business details, the buyer, the PO
                        and your supplier information to get started.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Opportunity submitted</strong>
                    <small>READY FOR VERIFICATION</small>
                </div>

            </article>


            <article class="how-step how-step-navy">

                <div class="how-step-number">02</div>

                <div class="how-step-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">VERIFY & ASSESS</span>
                    <h3>VERA checks and assesses the opportunity</h3>
                    <p>
                        Your evidence is verified and the opportunity is
                        assessed against fulfilment requirements and risk.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Fulfilment Assessment</strong>
                    <small>READINESS + RISK FLAGS</small>
                </div>

            </article>


            <article class="how-step how-step-gold">

                <div class="how-step-number">03</div>

                <div class="how-step-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">GET FUNDED</span>
                    <h3>Your Opportunity Profile reaches funders</h3>
                    <p>
                        A finance-ready profile is shared for review,
                        so you can access the working capital you're missing.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Funding Decision</strong>
                    <small>APPROVED • CONTROLLED FUNDING</small>
                </div>

            </article>


            <article class="how-step how-step-green">

                <div class="how-step-number">04</div>

                <div class="how-step-icon">
                    <i class="bi bi-patch-check"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">DELIVER</span>
                    <h3>Execute, settle, and build your history</h3>
                    <p>
                        Deliver the work, get paid by the buyer, and add a
                        verified outcome to your Fulfilment Passport.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Fulfilment Passport</strong>
                    <small>VERIFIED PERFORMANCE HISTORY</small>
                </div>

            </article>

        </div>

    </div>

</section>


<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="home-final">

    <div class="home-final-orb final-orb-one"></div>
    <div class="home-final-orb final-orb-two"></div>

    <div class="vera-container">

        <div class="home-final-inner">

            <div class="final-icon">
                <i class="bi bi-briefcase"></i>
            </div>

            <div class="final-copy">

                <span class="final-eyebrow">FOR SMEs</span>

                <h2>
                    Your next opportunity
                    <span>shouldn't wait on cash flow.</span>
                </h2>

                <p>
                    Upload your purchase order and start building
                    your first VERA Opportunity Profile today.
                </p>

            </div>

            <div class="final-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="final-primary">

                    Start your opportunity

                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Home"
                   asp-action="HowItWorks"
                   class="final-secondary">

                    See how VERA works

                </a>

            </div>

        </div>

    </div>

</section>

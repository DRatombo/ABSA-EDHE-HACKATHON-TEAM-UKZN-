@{
    ViewData["Title"] = "VERA for Funders";
}

<!-- =====================================================
     HERO
===================================================== -->

<section class="how-hero">

    <div class="how-hero-orb how-orb-one"></div>
    <div class="how-hero-orb how-orb-two"></div>

    <div class="vera-container how-hero-grid how-hero-solo">

        <div class="how-hero-copy">

            <div class="home-section-kicker">
                <span><i class="bi bi-bank"></i></span>
                FOR FUNDERS
            </div>

            <h1>
                Don't just finance a document.
                <span>Understand the opportunity.</span>
            </h1>

            <p>
                VERA packages each funding request as an explainable
                Opportunity Profile — verified evidence, fulfilment
                economics and risk flags, laid out before you decide.
            </p>

            <div class="how-hero-actions">

                <a class="vera-primary-button vera-main-cta"
                   asp-controller="Account"
                   asp-action="Register">

                    Explore the funder workspace

                    <i class="bi bi-arrow-right"></i>
                </a>

                <a class="vera-video-button"
                   asp-controller="Home"
                   asp-action="HowItWorks">

                    <span class="vera-play-icon">
                        <i class="bi bi-play-fill"></i>
                    </span>

                    See how VERA works
                </a>

            </div>

            <div class="how-stat-row">

                <div class="how-stat-card">
                    <strong>6</strong>
                    <span>Independent verification checks per opportunity</span>
                </div>

                <div class="how-stat-card">
                    <strong>0</strong>
                    <span>Unexplained black-box scores</span>
                </div>

                <div class="how-stat-card">
                    <strong>1:1</strong>
                    <span>Funding tied to verified fulfilment cost</span>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     WHY FUNDERS CHOOSE VERA
===================================================== -->

<section class="how-checks">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>01</span>
                    WHY FUNDERS CHOOSE VERA
                </div>

                <h2>
                    Evidence you can inspect,
                    <span>not a score you have to trust.</span>
                </h2>

            </div>

            <p>
                Every opportunity that reaches you has already been
                checked, assessed and structured — but every check
                is still visible, not hidden behind an algorithm.
            </p>

        </div>


        <div class="how-check-grid">

            <article class="how-check-card">
                <i class="bi bi-eye"></i>
                <h3>Explainable verification</h3>
                <p>
                    Business identity, representative authority, PO
                    integrity, buyer confirmation and supplier evidence —
                    each inspectable on its own.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-flag"></i>
                <h3>Capacity and risk flags</h3>
                <p>
                    See when a PO is materially larger than an SME's
                    demonstrated capacity, before you commit funding.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-calculator"></i>
                <h3>Structured funding requirement</h3>
                <p>
                    Fulfilment cost, SME contribution and funding gap
                    are calculated from the specific opportunity, not
                    estimated.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-lock"></i>
                <h3>Controlled disbursement</h3>
                <p>
                    Approved funds can be linked to verified suppliers
                    and fulfilment costs rather than released as
                    unrestricted cash.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-graph-up-arrow"></i>
                <h3>Portfolio-level visibility</h3>
                <p>
                    Track execution and settlement across every
                    opportunity you've funded, in one place.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-patch-check"></i>
                <h3>Verified track record</h3>
                <p>
                    Each SME's Fulfilment Passport gives you demonstrated
                    performance history, not just a first-time application.
                </p>
            </article>

        </div>

    </div>

</section>


<!-- =====================================================
     THE FUNDER WORKFLOW
===================================================== -->

<section class="how-process">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>02</span>
                    THE FUNDER WORKFLOW
                </div>

                <h2>
                    From submitted opportunity
                    <span>to a confident decision.</span>
                </h2>

            </div>

            <p>
                By the time an opportunity reaches your desk, VERA has
                already done the groundwork — you're reviewing, not
                reconstructing.
            </p>

        </div>


        <div class="how-step-list">

            <article class="how-step how-step-navy">

                <div class="how-step-number">01</div>

                <div class="how-step-icon">
                    <i class="bi bi-inbox"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">RECEIVE</span>
                    <h3>A verified Opportunity Profile arrives</h3>
                    <p>
                        Review a structured profile built from
                        already-verified business, PO and supplier evidence.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Opportunity Profile</strong>
                    <small>VERIFIED EVIDENCE ATTACHED</small>
                </div>

            </article>


            <article class="how-step how-step-purple">

                <div class="how-step-number">02</div>

                <div class="how-step-icon">
                    <i class="bi bi-search"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">INSPECT</span>
                    <h3>Review the evidence and risk flags</h3>
                    <p>
                        Drill into each individual check, the fulfilment
                        assessment and any capacity or risk flags raised.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Risk Picture</strong>
                    <small>PASS • REVIEW • BLOCK</small>
                </div>

            </article>


            <article class="how-step how-step-gold">

                <div class="how-step-number">03</div>

                <div class="how-step-icon">
                    <i class="bi bi-check2-square"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">DECIDE</span>
                    <h3>Approve, decline, or request more evidence</h3>
                    <p>
                        Make an informed funding decision based on the
                        structured funding requirement, not a guess.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Funding Decision</strong>
                    <small>APPROVED • DECLINED • REVIEW</small>
                </div>

            </article>


            <article class="how-step how-step-dark">

                <div class="how-step-number">04</div>

                <div class="how-step-icon">
                    <i class="bi bi-graph-up"></i>
                </div>

                <div class="how-step-copy">
                    <span class="how-step-label">MONITOR</span>
                    <h3>Track execution through to settlement</h3>
                    <p>
                        Follow controlled disbursement, fulfilment progress
                        and buyer payment across your funded opportunities.
                    </p>
                </div>

                <div class="how-step-output">
                    <span>OUTPUT</span>
                    <strong>Settlement Outcome</strong>
                    <small>VERIFIED PERFORMANCE HISTORY</small>
                </div>

            </article>

        </div>

    </div>

</section>


<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="home-final">

    <div class="home-final-orb final-orb-one"></div>
    <div class="home-final-orb final-orb-two"></div>

    <div class="vera-container">

        <div class="home-final-inner">

            <div class="final-icon">
                <i class="bi bi-bank"></i>
            </div>

            <div class="final-copy">

                <span class="final-eyebrow">FOR FUNDERS</span>

                <h2>
                    Fund the opportunity,
                    <span>not just the application.</span>
                </h2>

                <p>
                    Join VERA to review explainable, finance-ready
                    Opportunity Profiles from verified SMEs.
                </p>

            </div>

            <div class="final-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="final-primary">

                    Explore the funder workspace

                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Home"
                   asp-action="HowItWorks"
                   class="final-secondary">

                    See how VERA works

                </a>

            </div>

        </div>

    </div>

</section>


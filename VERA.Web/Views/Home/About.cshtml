@{
    ViewData["Title"] = "Why VERA";
}

<!-- =====================================================
     HERO
===================================================== -->

<section class="how-hero">

    <div class="how-hero-orb how-orb-one"></div>
    <div class="how-hero-orb how-orb-two"></div>

    <div class="vera-container how-hero-grid how-hero-solo">

        <div class="how-hero-copy">

            <div class="home-section-kicker">
                <span><i class="bi bi-lightbulb"></i></span>
                WHY VERA
            </div>

            <h1>
                Opportunity trusts growth.
                <span>Growth needs proof.</span>
            </h1>

            <p>
                VERA exists because winning a contract and being able
                to fund it are two different problems. We built the
                layer that connects the two — with evidence, not guesswork.
            </p>

            <div class="how-hero-actions">

                <a class="vera-primary-button vera-main-cta"
                   asp-controller="Account"
                   asp-action="Register">

                    Start your opportunity

                    <i class="bi bi-arrow-right"></i>
                </a>

                <a class="vera-video-button"
                   asp-controller="Home"
                   asp-action="HowItWorks">

                    <span class="vera-play-icon">
                        <i class="bi bi-play-fill"></i>
                    </span>

                    See how VERA works
                </a>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     THE PROBLEM WE STARTED WITH
===================================================== -->

<section class="home-gap">

    <div class="vera-container">

        <div class="home-gap-grid">

            <div class="home-gap-heading">

                <div class="home-section-kicker home-kicker-light">
                    <span>01</span>
                    WHERE VERA STARTED
                </div>

                <h2>
                    Too many good businesses
                    <span>stall on real, winnable work.</span>
                </h2>

            </div>

            <div class="home-gap-content">

                <p>
                    Across South Africa, SMEs win genuine purchase orders
                    every day — and still can't execute them, because the
                    working capital to fulfil the order isn't there.
                    Funders, meanwhile, are asked to finance a document
                    they can't fully verify or explain.
                </p>

                <div class="home-gap-stat">

                    <div class="home-gap-stat-icon">
                        <i class="bi bi-arrow-down-right"></i>
                    </div>

                    <div>
                        <span>THE GAP</span>

                        <strong>
                            Not a lack of opportunity.
                            A lack of visible, trustworthy evidence.
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     WHAT WE BELIEVE
===================================================== -->

<section class="how-checks">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>02</span>
                    WHAT WE BELIEVE
                </div>

                <h2>
                    A few principles
                    <span>shape everything VERA builds.</span>
                </h2>

            </div>

            <p>
                These ideas guide how VERA verifies opportunities, assesses
                risk and structures funding — for both sides of the desk.
            </p>

        </div>


        <div class="how-check-grid">

            <article class="how-check-card">
                <i class="bi bi-eye"></i>
                <h3>Evidence over guesswork</h3>
                <p>
                    Decisions should be based on verifiable facts about the
                    opportunity — not assumptions or paperwork alone.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-shield-check"></i>
                <h3>Explainable, not opaque</h3>
                <p>
                    Nobody should be asked to trust an unexplained score.
                    Every check VERA runs can be inspected on its own.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-people"></i>
                <h3>Fair to both sides</h3>
                <p>
                    SMEs deserve a real shot at funding their own success.
                    Funders deserve a real picture of the risk they're taking.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-lock"></i>
                <h3>Funding tied to fulfilment</h3>
                <p>
                    Capital should move toward the suppliers and costs it
                    was meant for, not disappear as unrestricted cash.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-graph-up-arrow"></i>
                <h3>Growth should compound</h3>
                <p>
                    A verified track record should make the next
                    opportunity easier to fund, not force a fresh start.
                </p>
            </article>

            <article class="how-check-card">
                <i class="bi bi-flag"></i>
                <h3>Built for South African SMEs</h3>
                <p>
                    VERA is designed around the real constraints and
                    opportunities facing South African small businesses.
                </p>
            </article>

        </div>

    </div>

</section>


<!-- =====================================================
     TEAM
===================================================== -->

<section class="how-example">

    <div class="vera-container how-example-grid">

        <div class="how-example-copy">

            <div class="home-section-kicker how-example-kicker">
                <span>03</span>
                THE TEAM
            </div>

            <h2>
                Built by Team UKZN
                <span>for the ABSA EDHE Hackathon.</span>
            </h2>

            <p>
                VERA started as a hackathon idea: what if the biggest
                blocker to SME growth wasn't a lack of opportunity, but a
                lack of trustworthy evidence connecting SMEs to funders?
                We're building the platform that closes that gap.
            </p>

        </div>


        <div class="how-example-card">

            <div class="how-example-top">

                <div>
                    <span>PROJECT</span>
                    <strong>VERA</strong>
                </div>

                <span class="vera-status-review">
                    IN DEVELOPMENT
                </span>

            </div>

            <div class="how-example-row">
                <span>Team</span>
                <strong>UKZN</strong>
            </div>

            <div class="how-example-row">
                <span>Programme</span>
                <strong>ABSA EDHE Hackathon</strong>
            </div>

            <div class="how-example-row how-example-total">
                <span>Mission</span>
                <strong>Opportunity trusts growth</strong>
            </div>

            <div class="how-example-result">

                <i class="bi bi-arrow-right-circle"></i>

                <div>
                    <span>NEXT</span>
                    <strong>Helping more SMEs go from PO to proof</strong>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="home-final">

    <div class="home-final-orb final-orb-one"></div>
    <div class="home-final-orb final-orb-two"></div>

    <div class="vera-container">

        <div class="home-final-inner">

            <div class="final-icon">
                <i class="bi bi-lightbulb"></i>
            </div>

            <div class="final-copy">

                <span class="final-eyebrow">READY TO SEE IT IN ACTION?</span>

                <h2>
                    Opportunity trusts growth.
                    <span>Let's put that to work.</span>
                </h2>

                <p>
                    Whether you're an SME with a purchase order or a funder
                    looking for explainable opportunities, VERA starts here.
                </p>

            </div>

            <div class="final-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="final-primary">

                    Get started

                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Home"
                   asp-action="HowItWorks"
                   class="final-secondary">

                    How VERA works

                </a>

            </div>

        </div>

    </div>

</section>

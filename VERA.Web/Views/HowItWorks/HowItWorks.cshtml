@{
    ViewData["Title"] = "How VERA Works";
}

<!-- =====================================================
     HERO
===================================================== -->

<section class="how-hero">

    <div class="how-hero-orb how-orb-one"></div>
    <div class="how-hero-orb how-orb-two"></div>

    <div class="vera-container how-hero-grid">

        <div class="how-hero-copy">

            <div class="home-section-kicker">
                <span>01</span>
                HOW VERA WORKS
            </div>

            <h1>
                From purchase order
                <span>to proven performance.</span>
            </h1>

            <p>
                VERA takes a commercial opportunity through a structured
                journey of verification, fulfilment assessment, funding,
                execution and settlement.
            </p>

        </div>


        <div class="how-hero-summary">

            <div class="how-summary-card">

                <div>
                    <span>START</span>
                    <strong>Purchase Order</strong>
                </div>

                <i class="bi bi-arrow-right"></i>

                <div>
                    <span>PROCESS</span>
                    <strong>VERA Assessment</strong>
                </div>

                <i class="bi bi-arrow-right"></i>

                <div>
                    <span>OUTCOME</span>
                    <strong>Finance-ready Opportunity</strong>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     SIX STEP JOURNEY
===================================================== -->

<section class="how-process">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>02</span>
                    THE VERA JOURNEY
                </div>

                <h2>
                    Six stages.
                    <span>One opportunity.</span>
                </h2>

            </div>

            <p>
                Each stage adds evidence, reduces uncertainty
                and gives both the SME and funder a clearer view
                of what is happening.
            </p>

        </div>


        <div class="how-step-list">


            <!-- VERIFY -->
            <article class="how-step how-step-red">

                <div class="how-step-number">
                    01
                </div>

                <div class="how-step-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div class="how-step-copy">

                    <span class="how-step-label">
                        VERIFY
                    </span>

                    <h3>
                        Is the opportunity real?
                    </h3>

                    <p>
                        VERA reviews the business, representative,
                        purchase order, buyer and supplier evidence
                        before the opportunity can move forward.
                    </p>

                </div>

                <div class="how-step-output">

                    <span>OUTPUT</span>

                    <strong>
                        Verification Profile
                    </strong>

                    <small>
                        PASS • REVIEW • BLOCK
                    </small>

                </div>

            </article>


            <!-- ASSESS -->
            <article class="how-step how-step-navy">

                <div class="how-step-number">
                    02
                </div>

                <div class="how-step-icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>

                <div class="how-step-copy">

                    <span class="how-step-label">
                        ASSESS
                    </span>

                    <h3>
                        Can the SME deliver?
                    </h3>

                    <p>
                        The opportunity is assessed against fulfilment
                        requirements, supplier readiness, timelines,
                        previous demonstrated capacity and execution risk.
                    </p>

                </div>

                <div class="how-step-output">

                    <span>OUTPUT</span>

                    <strong>
                        Fulfilment Assessment
                    </strong>

                    <small>
                        READINESS + RISK FLAGS
                    </small>

                </div>

            </article>


            <!-- STRUCTURE -->
            <article class="how-step how-step-gold">

                <div class="how-step-number">
                    03
                </div>

                <div class="how-step-icon">
                    <i class="bi bi-calculator"></i>
                </div>

                <div class="how-step-copy">

                    <span class="how-step-label">
                        STRUCTURE
                    </span>

                    <h3>
                        What does execution actually cost?
                    </h3>

                    <p>
                        VERA calculates the fulfilment cost,
                        SME contribution and the actual working-capital
                        gap required to execute the opportunity.
                    </p>

                </div>

                <div class="how-step-output">

                    <span>OUTPUT</span>

                    <strong>
                        Funding Gap
                    </strong>

                    <small>
                        COST • CONTRIBUTION • GAP
                    </small>

                </div>

            </article>


            <!-- MATCH -->
            <article class="how-step how-step-purple">

                <div class="how-step-number">
                    04
                </div>

                <div class="how-step-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>

                <div class="how-step-copy">

                    <span class="how-step-label">
                        MATCH
                    </span>

                    <h3>
                        Turn evidence into a funding decision.
                    </h3>

                    <p>
                        The verified opportunity is packaged into
                        an explainable Opportunity Profile that a funder
                        can review before making a decision.
                    </p>

                </div>

                <div class="how-step-output">

                    <span>OUTPUT</span>

                    <strong>
                        Opportunity Profile
                    </strong>

                    <small>
                        REVIEW + FUNDING DECISION
                    </small>

                </div>

            </article>


            <!-- EXECUTE -->
            <article class="how-step how-step-green">

                <div class="how-step-number">
                    05
                </div>

                <div class="how-step-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <div class="how-step-copy">

                    <span class="how-step-label">
                        EXECUTE
                    </span>

                    <h3>
                        Use funding for fulfilment.
                    </h3>

                    <p>
                        Where finance is approved, funds can be linked
                        to verified fulfilment costs and suppliers rather
                        than simply being released as unrestricted cash.
                    </p>

                </div>

                <div class="how-step-output">

                    <span>OUTPUT</span>

                    <strong>
                        Controlled Funding
                    </strong>

                    <small>
                        VERIFIED USE OF FUNDS
                    </small>

                </div>

            </article>


            <!-- SETTLE -->
            <article class="how-step how-step-dark">

                <div class="how-step-number">
                    06
                </div>

                <div class="how-step-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="how-step-copy">

                    <span class="how-step-label">
                        SETTLE
                    </span>

                    <h3>
                        Turn delivery into history.
                    </h3>

                    <p>
                        Once the buyer pays and the opportunity is settled,
                        the verified outcome becomes part of the SME's
                        Fulfilment Passport.
                    </p>

                </div>

                <div class="how-step-output">

                    <span>OUTPUT</span>

                    <strong>
                        Fulfilment Passport
                    </strong>

                    <small>
                        VERIFIED PERFORMANCE HISTORY
                    </small>

                </div>

            </article>


        </div>

    </div>

</section>


<!-- =====================================================
     WHAT VERA CHECKS
===================================================== -->

<section class="how-checks">

    <div class="vera-container">

        <div class="home-section-heading">

            <div>

                <div class="home-section-kicker">
                    <span>03</span>
                    EXPLAINABLE VERIFICATION
                </div>

                <h2>
                    No mystery score.
                    <span>Just visible evidence.</span>
                </h2>

            </div>

            <p>
                VERA doesn't hide the decision behind a single
                unexplained number. Each check can be inspected
                individually.
            </p>

        </div>


        <div class="how-check-grid">


            <article class="how-check-card">
                <i class="bi bi-building-check"></i>

                <h3>Business identity</h3>

                <p>
                    Does the business exist and do the submitted
                    details match?
                </p>

                <span class="how-check-pass">
                    VERIFIED
                </span>
            </article>


            <article class="how-check-card">
                <i class="bi bi-person-badge"></i>

                <h3>Representative authority</h3>

                <p>
                    Is the person submitting the opportunity
                    authorised to act for the business?
                </p>

                <span class="how-check-pass">
                    VERIFIED
                </span>
            </article>


            <article class="how-check-card">
                <i class="bi bi-file-earmark-check"></i>

                <h3>PO integrity</h3>

                <p>
                    Does the document appear consistent with the
                    submitted commercial opportunity?
                </p>

                <span class="how-check-pass">
                    VERIFIED
                </span>
            </article>


            <article class="how-check-card">
                <i class="bi bi-buildings"></i>

                <h3>Buyer confirmation</h3>

                <p>
                    Can the buyer and commercial relationship
                    be independently confirmed?
                </p>

                <span class="how-check-pass">
                    VERIFIED
                </span>
            </article>


            <article class="how-check-card">
                <i class="bi bi-box-seam"></i>

                <h3>Supplier evidence</h3>

                <p>
                    Are the suppliers and fulfilment costs
                    supported by evidence?
                </p>

                <span class="how-check-pass">
                    VERIFIED
                </span>
            </article>


            <article class="how-check-card how-check-review">

                <i class="bi bi-graph-up-arrow"></i>

                <h3>Fulfilment capacity</h3>

                <p>
                    Is the current opportunity materially larger
                    than the SME's demonstrated capacity?
                </p>

                <span>
                    REVIEW
                </span>

            </article>


        </div>

    </div>

</section>


<!-- =====================================================
     EXAMPLE OPPORTUNITY
===================================================== -->

<section class="how-example">

    <div class="vera-container how-example-grid">

        <div class="how-example-copy">

            <div class="home-section-kicker how-example-kicker">
                <span>04</span>
                EXAMPLE
            </div>

            <h2>
                See how one opportunity
                <span>moves through VERA.</span>
            </h2>

            <p>
                Nomvula Tech Solutions wins a R300,000 purchase order.
                VERA doesn't ask only whether the SME exists.
                It looks at what is required to execute this specific job.
            </p>


            <div class="how-example-warning">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>
                    <strong>
                        Capacity flag
                    </strong>

                    <span>
                        Largest previous verified PO: R75,000
                    </span>

                    <span>
                        Current PO: R300,000
                    </span>

                </div>

            </div>

        </div>


        <div class="how-example-card">

            <div class="how-example-top">

                <div>
                    <span>OPPORTUNITY</span>
                    <strong>PO #EC-45821</strong>
                </div>

                <span class="vera-status-review">
                    REVIEW
                </span>

            </div>


            <div class="how-example-row">

                <span>Purchase Order</span>

                <strong>
                    R300,000
                </strong>

            </div>


            <div class="how-example-row">

                <span>Fulfilment Cost</span>

                <strong>
                    R220,000
                </strong>

            </div>


            <div class="how-example-row">

                <span>SME Contribution</span>

                <strong>
                    R35,500
                </strong>

            </div>


            <div class="how-example-row how-example-total">

                <span>Funding Gap</span>

                <strong>
                    R184,500
                </strong>

            </div>


            <div class="how-example-result">

                <i class="bi bi-arrow-right-circle"></i>

                <div>
                    <span>RESULT</span>

                    <strong>
                        Finance-ready Opportunity Profile
                    </strong>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="home-final">

    <div class="home-final-orb final-orb-one"></div>
    <div class="home-final-orb final-orb-two"></div>

    <div class="vera-container">

        <div class="home-final-inner">

            <div class="final-icon">
                <i class="bi bi-arrow-up-right"></i>
            </div>


            <div class="final-copy">

                <span class="final-eyebrow">
                    READY TO BEGIN?
                </span>

                <h2>
                    Start with the opportunity
                    <span>you've already won.</span>
                </h2>

                <p>
                    Upload your purchase order and begin building
                    your VERA Opportunity Profile.
                </p>

            </div>


            <div class="final-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="final-primary">

                    Start your opportunity

                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Home"
                   asp-action="ForSMEs"
                   class="final-secondary">

                    Explore VERA for SMEs

                </a>

            </div>

        </div>

    </div>

</section>
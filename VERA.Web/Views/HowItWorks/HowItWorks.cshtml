@{
    ViewData["Title"] = "How VERA Works";
}

<!-- =====================================================
     HERO
===================================================== -->

<section class="how-hero">

    <div class="how-hero-shape how-shape-one"></div>
    <div class="how-hero-shape how-shape-two"></div>

    <div class="vera-container how-hero-layout">

        <div class="how-hero-left">

            <div class="home-section-kicker">
                <span>01</span>
                HOW VERA WORKS
            </div>

            <h1>
                One opportunity.
                <span>Six stages to execution.</span>
            </h1>

            <p>
                VERA turns a purchase order into a structured,
                verifiable and finance-ready opportunity — without
                hiding the decision behind a mystery score.
            </p>

            <div class="how-hero-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="how-primary-btn">

                    Start an opportunity

                    <i class="bi bi-arrow-right"></i>
                </a>

                

            </div>

        </div>


        <div class="how-hero-right">

            <div class="how-flow-card">

                <div class="how-flow-row">

                    <div class="how-flow-badge red">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <span>START</span>
                        <strong>Purchase Order</strong>
                    </div>

                </div>


                <div class="how-flow-line"></div>


                <div class="how-flow-row">

                    <div class="how-flow-badge navy">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>
                        <span>VERIFY</span>
                        <strong>Opportunity Evidence</strong>
                    </div>

                </div>


                <div class="how-flow-line"></div>


                <div class="how-flow-row">

                    <div class="how-flow-badge gold">
                        <i class="bi bi-calculator"></i>
                    </div>

                    <div>
                        <span>STRUCTURE</span>
                        <strong>Funding Gap</strong>
                    </div>

                </div>


                <div class="how-flow-line"></div>


                <div class="how-flow-row">

                    <div class="how-flow-badge green">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <div>
                        <span>OUTCOME</span>
                        <strong>Finance-ready Opportunity</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     SIX STEP JOURNEY
===================================================== -->

<section class="how-process">

    <div class="how-step-list">

    <!-- 01 VERIFY -->
    <article class="how-step how-step-red">

        <div class="how-step-marker">
            <span>01</span>
        </div>

        <div class="how-step-content">

            <div class="how-step-title-row">
                <div class="how-step-small-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <span class="how-step-label">VERIFY</span>
            </div>

            <h3>Is the opportunity real?</h3>

            <p>
                VERA reviews the business, representative, purchase order,
                buyer and supplier evidence before the opportunity can
                move forward.
            </p>

        </div>

        <div class="how-step-output">
            <span>OUTPUT</span>
            <strong>Verification Profile</strong>
            <small>PASS • REVIEW • BLOCK</small>
        </div>

    </article>


    <!-- 02 ASSESS -->
    <article class="how-step how-step-navy">

        <div class="how-step-marker">
            <span>02</span>
        </div>

        <div class="how-step-content">

            <div class="how-step-title-row">
                <div class="how-step-small-icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>

                <span class="how-step-label">ASSESS</span>
            </div>

            <h3>Can the SME deliver?</h3>

            <p>
                VERA assesses fulfilment requirements, supplier readiness,
                delivery timelines, previous demonstrated capacity and
                execution risk.
            </p>

        </div>

        <div class="how-step-output">
            <span>OUTPUT</span>
            <strong>Fulfilment Assessment</strong>
            <small>READINESS • RISK FLAGS</small>
        </div>

    </article>


    <!-- 03 STRUCTURE -->
    <article class="how-step how-step-gold">

        <div class="how-step-marker">
            <span>03</span>
        </div>

        <div class="how-step-content">

            <div class="how-step-title-row">
                <div class="how-step-small-icon">
                    <i class="bi bi-calculator"></i>
                </div>

                <span class="how-step-label">STRUCTURE</span>
            </div>

            <h3>What does execution actually cost?</h3>

            <p>
                VERA structures the fulfilment cost, SME contribution
                and actual working-capital gap required to deliver
                the opportunity.
            </p>

        </div>

        <div class="how-step-output">
            <span>OUTPUT</span>
            <strong>Funding Gap</strong>
            <small>COST • CONTRIBUTION • GAP</small>
        </div>

    </article>


    <!-- 04 MATCH -->
    <article class="how-step how-step-purple">

        <div class="how-step-marker">
            <span>04</span>
        </div>

        <div class="how-step-content">

            <div class="how-step-title-row">
                <div class="how-step-small-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>

                <span class="how-step-label">MATCH</span>
            </div>

            <h3>Turn evidence into a funding decision.</h3>

            <p>
                The verified opportunity becomes an explainable
                Opportunity Profile that a funder can review before
                making a funding decision.
            </p>

        </div>

        <div class="how-step-output">
            <span>OUTPUT</span>
            <strong>Opportunity Profile</strong>
            <small>REVIEW • FUNDING DECISION</small>
        </div>

    </article>


    <!-- 05 EXECUTE -->
    <article class="how-step how-step-green">

        <div class="how-step-marker">
            <span>05</span>
        </div>

        <div class="how-step-content">

            <div class="how-step-title-row">
                <div class="how-step-small-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <span class="how-step-label">EXECUTE</span>
            </div>

            <h3>Put the funding to work.</h3>

            <p>
                Approved funding is linked to verified fulfilment costs
                and suppliers, helping ensure capital is used to execute
                the opportunity.
            </p>

        </div>

        <div class="how-step-output">
            <span>OUTPUT</span>
            <strong>Controlled Funding</strong>
            <small>FULFILMENT-LINKED USE</small>
        </div>

    </article>


    <!-- 06 SETTLE -->
    <article class="how-step how-step-dark">

        <div class="how-step-marker">
            <span>06</span>
        </div>

        <div class="how-step-content">

            <div class="how-step-title-row">
                <div class="how-step-small-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <span class="how-step-label">SETTLE</span>
            </div>

            <h3>Turn delivery into bankable history.</h3>

            <p>
                Once the opportunity is delivered and settled, the verified
                outcome contributes to the SME's Fulfilment Passport and
                future performance history.
            </p>

        </div>

        <div class="how-step-output">
            <span>OUTPUT</span>
            <strong>Fulfilment Passport</strong>
            <small>VERIFIED PERFORMANCE HISTORY</small>
        </div>

    </article>

</div>

</section>


<!-- =====================================================
     WHAT VERA CHECKS
===================================================== -->

<section class="how-checks">

    <div class="how-check-grid">

    <article class="how-check-card">

        <div class="how-check-top">

            <div class="how-check-icon">
                <i class="bi bi-building-check"></i>
            </div>

            <span class="how-status how-status-pass">
                <i class="bi bi-check-circle-fill"></i>
                Verified
            </span>

        </div>

        <div class="how-check-content">

            <span class="how-check-number">01</span>

            <h3>Business identity</h3>

            <p>
                Does the business exist and do the submitted
                details match?
            </p>

        </div>

    </article>


    <article class="how-check-card">

        <div class="how-check-top">

            <div class="how-check-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <span class="how-status how-status-pass">
                <i class="bi bi-check-circle-fill"></i>
                Verified
            </span>

        </div>

        <div class="how-check-content">

            <span class="how-check-number">02</span>

            <h3>Representative authority</h3>

            <p>
                Is the person submitting the opportunity authorised
                to act for the business?
            </p>

        </div>

    </article>


    <article class="how-check-card">

        <div class="how-check-top">

            <div class="how-check-icon">
                <i class="bi bi-file-earmark-check"></i>
            </div>

            <span class="how-status how-status-pass">
                <i class="bi bi-check-circle-fill"></i>
                Verified
            </span>

        </div>

        <div class="how-check-content">

            <span class="how-check-number">03</span>

            <h3>PO integrity</h3>

            <p>
                Does the purchase order appear consistent with the
                submitted commercial opportunity?
            </p>

        </div>

    </article>


    <article class="how-check-card">

        <div class="how-check-top">

            <div class="how-check-icon">
                <i class="bi bi-buildings"></i>
            </div>

            <span class="how-status how-status-pass">
                <i class="bi bi-check-circle-fill"></i>
                Verified
            </span>

        </div>

        <div class="how-check-content">

            <span class="how-check-number">04</span>

            <h3>Buyer confirmation</h3>

            <p>
                Can the buyer and commercial relationship
                be independently confirmed?
            </p>

        </div>

    </article>


    <article class="how-check-card">

        <div class="how-check-top">

            <div class="how-check-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <span class="how-status how-status-pass">
                <i class="bi bi-check-circle-fill"></i>
                Verified
            </span>

        </div>

        <div class="how-check-content">

            <span class="how-check-number">05</span>

            <h3>Supplier evidence</h3>

            <p>
                Are suppliers and fulfilment costs supported by
                appropriate evidence?
            </p>

        </div>

    </article>


    <article class="how-check-card how-check-card-review">

        <div class="how-check-top">

            <div class="how-check-icon">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <span class="how-status how-status-review">
                <i class="bi bi-exclamation-circle-fill"></i>
                Review
            </span>

        </div>

        <div class="how-check-content">

            <span class="how-check-number">06</span>

            <h3>Fulfilment capacity</h3>

            <p>
                Is this opportunity materially larger than the SME's
                previously demonstrated delivery capacity?
            </p>

        </div>

    </article>

</div>

</section>


<!-- =====================================================
     EXAMPLE OPPORTUNITY
===================================================== -->



    <section class="how-example">

    <div class="vera-container how-example-grid">

        <!-- LEFT -->
        <div class="how-example-copy">

            <div class="home-section-kicker">
                <span>04</span>
                EXAMPLE
            </div>

            <h2>
                See how one opportunity
                <span>moves through VERA.</span>
            </h2>

            <p>
                Nomvula Tech Solutions wins a R300,000 purchase order.
                VERA looks beyond whether the SME exists and focuses on
                what is required to execute this specific opportunity.
            </p>

            <div class="how-example-warning">

                <div class="how-example-warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div class="how-example-warning-copy">

                    <span class="how-example-warning-label">
                        CAPACITY FLAG
                    </span>

                    <strong>
                        Current PO is 4× larger than previous verified capacity.
                    </strong>

                    <div class="how-example-capacity-values">

                        <div>
                            <span>Largest previous PO</span>
                            <strong>R75,000</strong>
                        </div>

                        <div>
                            <span>Current PO</span>
                            <strong>R300,000</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT -->
        <div class="how-example-card">

            <div class="how-example-card-header">

                <div>
                    <span class="how-example-card-eyebrow">
                        OPPORTUNITY
                    </span>

                    <h3>PO #EC-45821</h3>

                    <p>Nomvula Tech Solutions</p>
                </div>

                <span class="how-example-review-badge">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    Review
                </span>

            </div>


            <div class="how-example-financials">

                <div class="how-example-financial-row">
                    <span>Purchase Order</span>
                    <strong>R300,000</strong>
                </div>

                <div class="how-example-financial-row">
                    <span>Fulfilment Cost</span>
                    <strong>R220,000</strong>
                </div>

                <div class="how-example-financial-row">
                    <span>SME Contribution</span>
                    <strong>R35,500</strong>
                </div>

            </div>


            <div class="how-example-gap">

                <div>
                    <span>FUNDING GAP</span>
                    <strong>R184,500</strong>
                </div>

                <div class="how-example-gap-icon">
                    <i class="bi bi-arrow-up-right"></i>
                </div>

            </div>


            <div class="how-example-result">

                <div class="how-example-result-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <div>
                    <span>RESULT</span>
                    <strong>
                        Finance-ready Opportunity Profile
                    </strong>
                </div>

            </div>

        </div>

    </div>

</section>




<!-- =====================================================
     FINAL CTA
===================================================== -->

<section class="home-final">

    <div class="home-final-orb final-orb-one"></div>
    <div class="home-final-orb final-orb-two"></div>

    <div class="vera-container">

        <div class="home-final-inner">

            <div class="final-icon">
                <i class="bi bi-arrow-up-right"></i>
            </div>


            <div class="final-copy">

                <span class="final-eyebrow">
                    READY TO BEGIN?
                </span>

                <h2>
                    Start with the opportunity
                    <span>you've already won.</span>
                </h2>

                <p>
                    Upload your purchase order and begin building
                    your VERA Opportunity Profile.
                </p>

            </div>


            <div class="final-actions">

                <a asp-controller="Account"
                   asp-action="Register"
                   class="final-primary">

                    Start your opportunity

                    <i class="bi bi-arrow-right"></i>

                </a>

              

            </div>

        </div>

    </div>

</section>